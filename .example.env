# OpenAI
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TEXT_MODEL=gpt-4.1-mini
# App-funded comic generation admissions per UTC day, shared by all users and
# across Twilio channels plus browser studio tests using the app's OpenAI key.
# The code default is 25; the low-cost production pilot sets 5 on the web app
# and both runtime Jobs after initial runtime setup. 0 pauses generation.
# Retries count once per channel job, but a job may make up to three image
# attempts. Caller-owned API keys in the studio do not use app-funded capacity.
DAILY_GENERATION_JOB_LIMIT=25

# PostgreSQL: local development may use a local server. Production uses Azure
# Database for PostgreSQL Flexible Server in Central US. Its private VNet is
# peered to the East US 2 Container Apps VNet; connections use verify-full TLS.
DATABASE_URL=

# Auth.js. Google OAuth is optional for the browser testing studio. Change
# AUTH_URL to the port 8080 origin for pnpm dev:voice, or to the HTTPS tunnel
# origin when testing OAuth through it.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000
# Comma-separated Google email allowlist for production browser studio testers.
# Leave Google OAuth unset entirely if the studio is not in use.
STUDIO_TESTER_EMAILS=

# Password-protected operations dashboard at /admin/login. Choose a unique
# username; generate the scrypt hash with
# `pnpm exec tsx scripts/hash-admin-password.ts` and
# keep the hash in an ACA secret in production. There are no default credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Public app policy identity, supplied for this project. These values are also
# the code defaults; override only if the app operator/contact changes. Review
# /privacy and /terms before launch. Twilio's legal pages are provider policies.
APP_OPERATOR_NAME="Anthony Dellavecchia"
APP_CONTACT_EMAIL=adellavecchia@twilio.com

# Azure Storage. Use the connection string for local/Azurite development only;
# production uses the endpoints and each workload's managed identity.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_BLOB_ENDPOINT=https://YOUR_ACCOUNT.blob.core.windows.net
AZURE_STORAGE_QUEUE_ENDPOINT=https://YOUR_ACCOUNT.queue.core.windows.net
AZURE_STORAGE_CONTAINER_NAME=comics
AZURE_STORAGE_QUEUE_NAME=comic-generation
AZURE_STORAGE_POISON_QUEUE_NAME=comic-generation-poison
AZURE_CLIENT_ID=
MEDIA_SIGNING_SECRET=

# Twilio public channels are an explicit release switch. Unset or empty means
# no public contact actions and no inbound SMS/Voice/WhatsApp processing. Set an
# ordered comma-separated list only after each sender, webhook, legal page,
# toll-free approval, and end-to-end test is ready. First launch: sms,voice.
# Voice also requires the Verify service and secure Relay URL below before its
# public action appears. This flag cannot query sender approvals in Twilio.
TWILIO_ENABLED_CHANNELS=
# Use a real E.164 number with the capabilities you select. Voice results are
# sent by SMS, so even a voice-only launch needs outbound SMS on this number.
# First-launch number after verification: +18669012028. Leave blank here so a
# copied example cannot advertise the number before production is configured.
# Never use +15551234567 as a live call to action.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Required for Voice and the optional browser photo booth: a Twilio Verify
# service that sends six-digit SMS codes. A caller enters the code on their
# keypad before ConversationRelay starts; booth visitors enter it on the page.
TWILIO_VERIFY_SERVICE_SID=
# Voice webhook only: Verify SMS starts across the Twilio number in a rolling
# 24 hours. Code default 40; low-cost production pilot 4. 0 pauses starts.
VOICE_VERIFY_NUMBER_DAILY_LIMIT=40
# Optional browser photo booth Verify-start limits across all visitors. The
# admin booth switch is off by default. Defaults are 30 per rolling hour and
# 50 per rolling day; the maximum accepted values are 100 and 500.
# CAMERA_VERIFY_GLOBAL_HOURLY_LIMIT=30
# CAMERA_VERIFY_GLOBAL_DAILY_LIMIT=50

# Text worker only: agent turns across SMS and WhatsApp in a rolling 24 hours.
# Code default 200; low-cost production pilot 50. 0 pauses new agent turns.
# Inbound carrier charges can still accrue when this limit is reached.
MESSAGE_AGENT_GLOBAL_DAILY_LIMIT=200

# Optional approved WhatsApp sender. Include the whatsapp: prefix and a real
# E.164 sender number. It can be the only enabled public start channel.
# With no available channel, the page says "opening soon".
# TWILIO_WHATSAPP_NUMBER=whatsapp:+YOUR_APPROVED_NUMBER

# Optional pair for authenticated Twilio media downloads. Set both or neither.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Public canonical origin used for Twilio signature validation. Use the exact
# HTTPS tunnel origin for local Twilio testing; do not append retry fragments.
PUBLIC_BASE_URL=https://YOUR_DOMAIN
# Required when Voice is enabled. Use the public wss:// /relay URL without a
# retry fragment; leave blank for SMS/WhatsApp-only setups.
CONVERSATION_RELAY_WS_URL=

# Optional Dub short links for finished channel comics. Set all three on the
# generation Job to enable them; otherwise result texts use the branded
# PUBLIC_BASE_URL/story/... page directly. Create a folder in the same Dub
# workspace and copy its ID. DUB_DOMAIN must be a domain verified for that
# workspace. The operator reports twil.io is verified there; confirm this API
# key uses that workspace before setting DUB_DOMAIN=twil.io. Keep the API key
# in Key Vault/ACA secrets, never in source.
DUB_API_KEY=
DUB_DOMAIN=
DUB_FOLDER_ID=
# Result texts are SMS with the comic link and no image attachment by default.
# Set true on the generation Job to opt back into an outbound MMS image preview.
RESULT_MEDIA_PREVIEW_ENABLED=false

# Combined web/voice server defaults. pnpm dev:voice uses port 8080.
PORT=8080
HOSTNAME=0.0.0.0
WORKER_ID=
RELEASE_SHA=development

# Set only on the scheduled recovery Job, not the public app or queue Job.
# RECOVERY_MODE=1
